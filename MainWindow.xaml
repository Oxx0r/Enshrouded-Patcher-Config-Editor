<Window x:Class="EnshroudedConfigManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enshrouded Patcher Config Editor" Height="850" Width="800"
        Background="#1A1A1A" Foreground="White" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enshrouded Patcher Config Editor" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Foreground="#3a7ebf" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="MainStackPanel">
                <!-- Wichtig: x:Name stellt die Verbindung zum C#-Code her -->
                <StackPanel x:Name="PathSection" Margin="0,0,0,15"/>
                <StackPanel x:Name="ModSection"/>
                <StackPanel x:Name="SettingsSection" Margin="0,15,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <!-- Linke Seite: KFC Parser Version -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="KFC Parser Version: " VerticalAlignment="Center" FontSize="11"/>
                <TextBox x:Name="TxtVersion" Width="100" Height="22" Background="#2b2b2b" Foreground="White" BorderBrush="#3a7ebf" TextChanged="MarkAsDirty"/>
            </StackPanel>

            <!-- Rechte Seite: Save Button (Jetzt Grün) -->
            <Button Content="Save Configuration" DockPanel.Dock="Right" 
                    Width="180" Height="40" Background="#2e7d32" Foreground="White"
                    Click="SaveButton_Click" BorderThickness="0"/>

            <!-- Mitte: Start Patcher Button (Jetzt Blau) -->
            <Button Content="Start Patcher" Margin="20,0,20,0"
                    Width="180" Height="40" Background="#1f538d" Foreground="White"
                    Click="PatchAndRunButton_Click" BorderThickness="0" HorizontalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>